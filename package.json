        "@mui/material": "^9.2.0",
        "keycloakify": "^11.15.9",
        "qrcode.react": "^4.2.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-is": "^18.2.0",
        "react-number-format": "^5.4.5",
